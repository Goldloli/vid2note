# ============================================
# vid2note - 环境变量示例
# 视频 → Markdown 笔记 + 思维导图的本地工具(Docker Web 应用,localhost:8765)
# 用法:cp .env.example .env  然后填入你要用的 LLM API Key
# ============================================

# 默认 LLM 提供商(可选:deepseek/qwen/glm/moonshot/baidu/doubao/minimax/ollama)
LLM_PROVIDER=deepseek

# 服务端口(单容器:FastAPI 同源托管 API + 前端静态,统一用此端口)
BACKEND_PORT=8765

# 处理选项(运行时亦可在「设置」页调整,持久化于 SQLite)
EXTRACT_IMAGES=false

# ============================================
# 各 LLM 提供商 API Key
# 只需配置你要使用的那个即可;其余也可在「设置」页填写(运行时存 SQLite)
# ============================================

# DeepSeek(默认)- https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen(通义千问)- https://dashscope.console.aliyun.com
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# GLM(智谱)- https://open.bigmodel.cn
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Moonshot(Kimi)- https://platform.moonshot.cn
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k

# 说明:运行时配置(ASR 引擎 / bilibili cookie / 保留策略 / 并发 / 截图 / PDF 方式 / 输出语言)
# 均在 Web「设置」页配置,持久化于本地 SQLite,不在此文件。
# 敏感提醒:本文件仅作模板,不要填真实 key 后提交;真实 key 放 .env(已 gitignore)或设置页。
