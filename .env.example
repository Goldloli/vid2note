# .env.example — 复制为 .env 并填入你的 API 密钥：
# cp .env.example .env

# 必填：至少配置一个 LLM API Key
OPENAI_API_KEY=sk-your-key-here

# 可选：其他 LLM 提供商
DASHSCOPE_API_KEY=sk-your-dashscope-key
ZHIPU_API_KEY=your-zhipu-key
MOONSHOT_API_KEY=sk-your-moonshot-key
DEEPSEEK_API_KEY=sk-your-deepseek-key
BAICHUAN_API_KEY=sk-your-baichuan-key
VOLCANO_API_KEY=your-volcano-key

# 可选：本地 Ollama
OLLAMA_BASE_URL=http://localhost:11434

# 可选：ASR 配置
ASR_PROVIDER=asrtools
ASRTOOLS_API_KEY=your-asrtools-key

# 服务端配置
VID2NOTE_HOST=0.0.0.0
VID2NOTE_PORT=8000
VID2NOTE_LOG_LEVEL=info
VID2NOTE_DATA_DIR=./data

# 可选：Sentry 错误上报
SENTRY_DSN=
