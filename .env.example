# 复制为 .env 后按需修改。不要提交包含真实密钥的 .env。

# 宿主访问端口。Compose 默认只监听 127.0.0.1。
VID2NOTE_PORT=8761

# Linux 上应与当前用户的 id -u / id -g 一致；macOS/Windows 通常无需修改。
VID2NOTE_UID=1000
VID2NOTE_GID=1000

# 默认 LLM：deepseek/qwen/glm/moonshot/baidu/doubao/minimax/ollama
LLM_PROVIDER=deepseek

# Web 设置页写入的 API Key/Cookie 会加密到 data/config/credentials.enc。
# 推荐生产环境用下列二选一方式提供 Fernet 主密钥：
# 1. VID2NOTE_MASTER_KEY=（Fernet.generate_key() 生成的 URL-safe base64）
# 2. 把密钥以只读文件挂载到 /run/secrets/vid2note_master_key。
# 两者留空时会自动生成 data/config/master.key（权限 0600）；请与数据一起备份。
VID2NOTE_MASTER_KEY=
VID2NOTE_MASTER_KEY_FILE=

# DeepSeek（默认）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Qwen
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# GLM
GLM_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Moonshot
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 百度千帆（v2 Bearer API Key）
BAIDU_API_KEY=
BAIDU_MODEL=ernie-5.0
BAIDU_BASE_URL=https://qianfan.baidubce.com/v2

# Doubao
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-0-lite-260215
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# MiniMax
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Ollama 运行在宿主机时，容器通过 host.docker.internal 访问。
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3.5

# 单个自定义 OpenAI Chat Completions 兼容槽位（也可在 Web 设置页填写）。
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_BASE_URL=

# 流式上传上限，单位 MB。
MAX_MEDIA_UPLOAD_MB=2048
MAX_PDF_UPLOAD_MB=100

# 默认拒绝 localhost、私网和保留网段 URL，避免下载器被用于访问内网服务。
ALLOW_PRIVATE_URLS=false

# 其他 Provider 凭证、Bilibili Cookie、ASR、并发和保留策略可在 Web「设置」页配置。
# 非敏感设置位于 data/config/settings.json；密钥不会写入该文件。
