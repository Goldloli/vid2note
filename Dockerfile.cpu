# vid2note CPU 版本
# 基于 python:3.11-slim，无 GPU 支持，适合普通服务器部署

FROM python:3.11-slim AS builder

WORKDIR /app

# 安装系统依赖（构建阶段）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（带超时与重试，避免网络波动）
RUN pip install --no-cache-dir --timeout 120 --retries 5 uv

# 复制 workspace 配置
COPY pyproject.toml ./
COPY core/ ./core/
COPY server/ ./server/

# 使用 uv 构建并安装依赖（CPU 版本，不安装 torch）
RUN uv pip install --system --no-cache \
    -e ./core \
    -e ./server

# 生产阶段
FROM python:3.11-slim AS production

WORKDIR /app

# 安装运行时系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 复制 Python 环境
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 复制应用代码
COPY --from=builder /app/core /app/core
COPY --from=builder /app/server /app/server
COPY pyproject.toml ./

# 创建数据目录
RUN mkdir -p /app/data

# 非 root 用户运行
RUN useradd -m -u 1000 vid2note && chown -R vid2note:vid2note /app/data
USER vid2note

# 环境变量
ENV PYTHONPATH=/app/core/src:/app/server/src
ENV VID2NOTE_DATA_DIR=/app/data
ENV VID2NOTE_HOST=0.0.0.0
ENV VID2NOTE_PORT=8000

EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "vid2note_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
