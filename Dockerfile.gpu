# vid2note GPU 版本
# 基于 nvidia/cuda 镜像，支持 CUDA 加速（本地 ASR 模型）
# 构建命令: docker build -f Dockerfile.gpu -t vid2note:gpu .

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04 AS builder

WORKDIR /app

# 安装 Python 3.11 和系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    build-essential \
    git \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv
RUN python3.11 -m pip install --no-cache-dir uv

# 复制 workspace 配置
COPY pyproject.toml ./
COPY core/ ./core/
COPY server/ ./server/

# 安装 GPU 版本依赖（包含 torch + funasr）
RUN uv pip install --system --no-cache \
    -e "./core[local-asr]" \
    -e ./server

# 生产阶段
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04 AS production

WORKDIR /app

# 安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 复制 Python 环境
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 复制应用代码
COPY --from=builder /app/core /app/core
COPY --from=builder /app/server /app/server
COPY pyproject.toml ./

# 创建数据目录
RUN mkdir -p /app/data

# 非 root 用户运行
RUN useradd -m -u 1000 vid2note && chown -R vid2note:vid2note /app/data
USER vid2note

# 环境变量
ENV PYTHONPATH=/app/core/src:/app/server/src
ENV VID2NOTE_DATA_DIR=/app/data
ENV VID2NOTE_HOST=0.0.0.0
ENV VID2NOTE_PORT=8000

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["python3.11", "-m", "uvicorn", "vid2note_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
