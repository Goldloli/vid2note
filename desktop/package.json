{
  "name": "vid2note-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "uv run --project .. python ../scripts/prepare_package.py && vite build && electron-builder",
    "test:package": "node tests/package-smoke.js",
    "test:e2e": "playwright test",
    "test:main": "node --test tests/unit/*.test.js",
    "contracts:export": "PYTHONPATH=../core/src:../server/src ../.venv/bin/python ../scripts/export_openapi.py openapi.json",
    "contracts:generate": "openapi-typescript openapi.json -o src/renderer/api/generated/schema.ts",
    "contracts:check": "npm run contracts:export && npm run contracts:generate && git diff --exit-code -- openapi.json src/renderer/api/generated/schema.ts",
    "test:unit": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@element-plus/icons-vue": "^2.3.0",
    "axios": "^1.6.0",
    "dompurify": "^3.4.11",
    "element-plus": "^2.5.0",
    "markdown-it": "^14.2.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "build": {
    "appId": "com.vid2note.app",
    "productName": "vid2note",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../python-dist/vid2note",
        "to": "backend"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    }
  }
}
